elio_assessment:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT', 'configure_account') }}"
      user: "{{ env_var('SNOWFLAKE_USER', 'configure_user') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'SYSADMIN') }}"
      authenticator: "{{ env_var('SNOWFLAKE_AUTHENTICATOR', 'externalbrowser') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'ELIO_ASSESSMENT') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'ELIO_ASSESSMENT_WH') }}"
      schema: "{{ env_var('DBT_SCHEMA', 'DEV') }}"
      threads: 4
      client_session_keep_alive: false
      query_tag: elio_assessment_dbt
    ci:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT', 'configure_account') }}"
      user: "{{ env_var('SNOWFLAKE_USER', 'configure_user') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'ELIO_CI_ROLE') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH', '/configure/key.p8') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'ELIO_ASSESSMENT') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'ELIO_ASSESSMENT_WH') }}"
      schema: "{{ env_var('DBT_SCHEMA', 'CI') }}"
      threads: 4
    local:
      type: duckdb
      path: "{{ env_var('ELIO_LOCAL_DB', '../data/olist.duckdb') }}"
      schema: dev
      threads: 4
